#!/bin/sh
set -e
# the C kernels compiled by postinst are not in the package's file list
rm -f /usr/lib/sdr-cmts/cmts/_usdsp.so /usr/lib/sdr-cmts/cmts/_dsdsp.so /usr/lib/sdr-cmts/cmts/_fastdsp.so
rm -rf /usr/lib/sdr-cmts/cmts/__pycache__ /usr/lib/sdr-cmts/__pycache__
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi
if [ "$1" = purge ]; then
    rm -rf /var/lib/sdr-cmts
fi
exit 0
