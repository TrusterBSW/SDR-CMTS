# Deux B210 (branche multi-b210) : 12 DS (6 par B210) + 2 US
#   /root/cmts-tools/run_multi.sh <nom> @configs/multi-b210.args
# Numéros de série : uhd_find_devices (le premier émet les canaux bas ET reçoit le montant).
--us-channels 2
--us-target -20
--ds-channels 12
--ds-radios 2
--radio-serials SERIE_B210_1,SERIE_B210_2
# 10 MHz commun sur les entrées « 10MHz » des deux B210 (ex. CLKOUT du HackRF -> répartiteur) ;
# sans référence commune : internal (dérive ~1 ms / 10 min entre les deux)
--clock-source external
